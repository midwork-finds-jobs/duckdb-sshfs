# name: test/sql/secrets/persistent_secret_sshfs.test
# description: Persistent SSH secrets survive a restart
# group: [secrets]

require sshfs

require skip_reload

load {TEST_DIR}/persistent_secret_sshfs.db

statement ok
SET secret_directory='{TEST_DIR}/persistent_secret_sshfs_secrets';

statement ok
CREATE PERSISTENT SECRET ssh_persist (
    TYPE SSH,
    username 'persist_user',
    password 'persist_password',
    port 2222,
    SCOPE 'sshfs://persist.example.com'
);

restart

statement ok
SET secret_directory='{TEST_DIR}/persistent_secret_sshfs_secrets';

query III
SELECT name, type, persistent FROM duckdb_secrets() WHERE name = 'ssh_persist';
----
ssh_persist	ssh	true

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'ssh_persist' AND contains(secret_string, 'username=persist_user') AND contains(secret_string, 'password=redacted');
----
1

statement ok
DROP PERSISTENT SECRET ssh_persist;
